# Non-secret local configuration. The default Compose stack binds no host ports;
# services communicate on the private Docker network.
NETWORK_DB_NAME=cholopay_network
COSTA_DB_NAME=cholopay_costa
SIERRA_DB_NAME=cholopay_sierra
ORIENTE_DB_NAME=cholopay_oriente
POSTGRES_USER=cholopay
POSTGRES_PASSWORD=cholopay_local_only
COMPOSE_PROJECT_NAME=cholopay_phase1
# Required for the protected synthetic internal endpoints.
OPERATOR_CONSOLE_TOKEN=replace-local-operator-token
DIRECTORY_PORT_TOKEN=replace-local-directory-port-token
# Synthetic bank-to-CholoNet HMAC; leave empty to keep outbox publication fail-closed.
CHOLONET_HMAC_SECRET=
# Synthetic network-to-bank receiver-credit HMAC for Docker only.
NETWORK_ADAPTER_SECRET=local-test-only
# Synthetic receiver delivery lease in seconds; valid range is 5..3600.
DELIVERY_LEASE_SECONDS=60
OUTBOX_ENABLED=false
# Identidades sintéticas independientes para Sierra y Oriente.
SIERRA_NETWORK_ADAPTER_SECRET=sierra-local-test-only
SIERRA_GATEWAY_API_KEY=sk_sandbox_sierra_rw
SIERRA_BANK_API_TOKEN=bank-sierra-local-test-only
SIERRA_BILLER_UTILITIES_CLEARING_ACCOUNT_ID=00000000-0000-4000-8000-000000000012
SIERRA_CHOLONET_HMAC_SECRET=
SIERRA_OUTBOX_ENABLED=false
ORIENTE_NETWORK_ADAPTER_SECRET=oriente-local-test-only
ORIENTE_GATEWAY_API_KEY=sk_sandbox_oriente_rw
ORIENTE_BANK_API_TOKEN=bank-oriente-local-test-only
ORIENTE_BILLER_UTILITIES_CLEARING_ACCOUNT_ID=00000000-0000-4000-8000-000000000022
ORIENTE_CHOLONET_HMAC_SECRET=
ORIENTE_OUTBOX_ENABLED=false
