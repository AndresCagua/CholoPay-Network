# Non-secret local configuration. The default Compose stack binds no host ports;
# services communicate on the private Docker network.
NETWORK_DB_NAME=cholopay_network
COSTA_DB_NAME=cholopay_costa
SIERRA_DB_NAME=cholopay_sierra
ORIENTE_DB_NAME=cholopay_oriente
POSTGRES_USER=cholopay
POSTGRES_PASSWORD=cholopay_local_only
COMPOSE_PROJECT_NAME=cholopay_phase1
# Required for the protected synthetic internal endpoints.
OPERATOR_CONSOLE_TOKEN=replace-local-operator-token
DIRECTORY_PORT_TOKEN=replace-local-directory-port-token
# Synthetic bank-to-CholoNet HMAC; leave empty to keep outbox publication fail-closed.
CHOLONET_HMAC_SECRET=
OUTBOX_ENABLED=false
